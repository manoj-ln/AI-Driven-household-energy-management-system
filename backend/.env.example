# AI-Driven Household Energy Management System - Environment Configuration

# --- Application Settings ---
PROJECT_NAME="AI-Driven Household Energy Management"
DEBUG=true
API_PREFIX=/api

# --- Authentication ---
# Change this to a strong random string in production!
AUTH_SECRET_KEY=change-this-secret-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# --- Database ---
# Path to SQLite database file (default: backend/data/energy_management.db)
DATABASE_PATH=

# For PostgreSQL (future use):
# DATABASE_URL=postgresql://user:password@localhost:5432/energy_management

# --- Redis ---
# For caching and rate limiting (future use):
# REDIS_URL=redis://localhost:6379/0

# --- Tariff Rates ---
# BESCOM electricity tariff rates in INR (FY2026-27 LT-1 Domestic)
BESCOM_BASE_RATE=5.80
BESCOM_SURCHARGE_RATE=0.35
BESCOM_FIXED_CHARGE_PER_KW=150.00
BESCOM_ELECTRICITY_TAX_RATE=0.09

# --- Weather API ---
# Open-Meteo API is free and doesn't require an API key
# For production, consider using a paid weather service
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- ML Model Settings ---
MODEL_DIR=models/trained
MODEL_PERFORMANCE_FILE=model_performances.pkl